# ==========================================
# SmartAttend AI - Environment Configuration
# ==========================================

# Server Port
PORT=3000

# GEMINI_API_KEY: Injected by AI Studio or configured for smart AI attendance insights
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current applet URL
APP_URL="http://localhost:3000"

# MySQL Database Credentials
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="smartattend_db"
DB_USER="smartattend_user"
DB_PASSWORD="your_secure_mysql_password"

# n8n Automation Webhook URLs
N8N_WEBHOOK_BASE_URL="https://n8n.yourdomain.com/webhook"
N8N_ATTENDANCE_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/attendance-recorded"
N8N_LOW_ATTENDANCE_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/low-attendance-alert"
N8N_LEAVE_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/leave-request-update"
N8N_WEBHOOK_SECRET="smartattend_n8n_secret_token_123"

# Email Notification Credentials (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@smartattend.college.edu"
SMTP_PASS="your_email_app_password"
EMAIL_FROM="SmartAttend AI <notifications@smartattend.college.edu>"

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_CHAT_ID="@smartattend_alerts"

# Attendance Policy Thresholds (Percentages)
ATTENDANCE_SAFE_THRESHOLD="80"
ATTENDANCE_WARNING_THRESHOLD="75"
ATTENDANCE_RISK_THRESHOLD="65"
